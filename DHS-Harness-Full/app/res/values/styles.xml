<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/deepseek</item>
        <item name="android:colorPrimaryDark">@color/deepseek_dark</item>
        <item name="android:colorAccent">@color/deepseek</item>
        <!-- 状态栏/导航栏与 Web UI 顶栏同色：原先的品牌蓝横在最上方，与手机整体不搭 -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="HeaderTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_on_accent</item>
    </style>

    <style name="HeaderSubtitle">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#D6DDFF</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
